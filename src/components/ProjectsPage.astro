---
import { GITHUB_ORG_URL, type Lang, t } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);
---

<section class="mx-auto max-w-6xl px-6 pt-20 pb-24 lg:pt-24">
	<header class="max-w-3xl">
		<p class="font-mono text-sm text-esap-blue-strong">{m.projects.kicker}</p>
		<h1 class="mt-4 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
			{m.projects.title}
		</h1>
		<p class="mt-5 text-base leading-relaxed text-muted-foreground sm:text-lg">
			{m.projects.description}
		</p>
	</header>

	{
		m.projects.groups.map((group, gi) => (
			<section data-reveal class="mt-16">
				<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
					<h2 class="text-xl font-semibold tracking-tight">{group.heading}</h2>
					<p class="text-sm text-muted-foreground">{group.note}</p>
				</div>
				<ul class="mt-6 border-t border-border">
					{group.items.map((item) => (
						<li class="border-b border-border">
							<div class="grid gap-3 py-5 sm:grid-cols-[minmax(0,16rem)_1fr_auto] sm:items-center sm:gap-6">
								<div class="flex items-center gap-3">
									<a
										href={item.href}
										target="_blank"
										rel="noopener noreferrer"
										class="font-medium tracking-tight transition-colors hover:text-esap-blue-strong"
									>
										{item.name}
									</a>
									<span class="rounded bg-surface-2 px-1.5 py-0.5 font-mono text-xs text-muted-foreground">
										{item.tech}
									</span>
								</div>
								<p class="text-sm leading-relaxed text-muted-foreground">{item.tagline}</p>
								<span class="flex items-center gap-4 text-sm">
									{"site" in item && item.site ? (
										<a
											href={item.site}
											target="_blank"
											rel="noopener noreferrer"
											class="font-medium text-esap-blue-strong transition-opacity hover:opacity-80"
										>
											{new URL(item.site).hostname}
										</a>
									) : null}
									<a
										href={item.href}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`${item.name} on GitHub`}
										class="text-muted-foreground transition-colors hover:text-foreground"
									>
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M7 17 17 7" />
											<path d="M7 7h10v10" />
										</svg>
									</a>
								</span>
							</div>
						</li>
					))}
				</ul>
				{gi === m.projects.groups.length - 1 && (
					<div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
						<a
							href={GITHUB_ORG_URL}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1.5 text-sm font-medium text-esap-blue-strong transition-opacity hover:opacity-80"
						>
							{m.projects.fullListCta}
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M7 17 17 7" />
								<path d="M7 7h10v10" />
							</svg>
						</a>
						<p class="text-sm text-muted-foreground">{m.projects.involve}</p>
					</div>
				)}
			</section>
		))
	}
</section>
