---
import { type Lang, t } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);
const a = m.archive;

/* ESAP 粉 / AsterCosmos 蓝：两个同级组织的对照卡 */
const pillarAccents = ["border-esap-pink", "border-esap-blue"] as const;
---

<section class="mx-auto max-w-6xl px-6 pt-20 pb-24 lg:pt-24">
	<header class="max-w-3xl">
		<p class="font-mono text-sm text-esap-pink-strong">{a.kicker}</p>
		<h1 class="mt-4 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
			{a.title}
		</h1>
		<p class="mt-5 text-base leading-relaxed text-muted-foreground sm:text-lg">
			{a.description}
		</p>
	</header>

	<div data-reveal class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-border sm:grid-cols-2">
		{
			a.pillars.map((pillar, i) => (
				<div class={`border-t-2 bg-surface-3 p-7 ${pillarAccents[i]}`}>
					<p class="font-mono text-xs tracking-wide text-muted-foreground uppercase">
						{pillar.subheading}
					</p>
					<h2 class="mt-3 text-xl font-semibold tracking-tight">{pillar.heading}</h2>
					<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{pillar.body}</p>
					<a
						href={pillar.href}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-esap-blue-strong transition-opacity hover:opacity-80"
					>
						{pillar.cta}
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M7 17 17 7" />
							<path d="M7 7h10v10" />
						</svg>
					</a>
				</div>
			))
		}
	</div>

	<ul class="mt-10 grid gap-4 sm:grid-cols-3">
		{
			a.points.map((point) => (
				<li class="flex items-start gap-3 text-sm leading-relaxed text-muted-foreground">
					<span class="mt-2 inline-block size-1.5 shrink-0 rounded-full bg-esap-pink" aria-hidden="true" />
					{point}
				</li>
			))
		}
	</ul>

	{/* ESAP 侧站点入口 */}
	<section data-reveal class="mt-16">
		<p class="font-mono text-sm text-muted-foreground">{a.esapSites.kicker}</p>
		<div class="mt-6 grid gap-px overflow-hidden rounded-2xl bg-border sm:grid-cols-2">
			{
				a.esapSites.items.map((site) => (
					<a
						href={site.href}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex flex-col bg-surface-3 p-7 transition-colors hover:bg-surface-2"
					>
						<h3 class="font-mono text-base font-medium tracking-tight">{site.name}</h3>
						<p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">{site.body}</p>
						<span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-esap-pink-strong">
							{site.href.replace("https://", "")}
							<svg
								width="14"
								height="14"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
							>
								<path d="M7 17 17 7" />
								<path d="M7 7h10v10" />
							</svg>
						</span>
					</a>
				))
			}
		</div>
	</section>
</section>
