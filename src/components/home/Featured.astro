---
import { Image } from "astro:assets";
import heroDarkEn from "@/assets/scenes/hero-dark-en.webp";
import heroDarkZh from "@/assets/scenes/hero-dark-zh.webp";
import heroLightEn from "@/assets/scenes/hero-light-en.webp";
import heroLightZh from "@/assets/scenes/hero-light-zh.webp";
import { DRIVE_GITHUB_URL, DRIVE_URL, type Lang, pagePath, t } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);
const shotLight = lang === "zh" ? heroLightZh : heroLightEn;
const shotDark = lang === "zh" ? heroDarkZh : heroDarkEn;
---

<section data-reveal class="mx-auto max-w-6xl px-6 pb-24">
	<div class="overflow-hidden rounded-2xl bg-surface-2">
		<div class="grid items-center gap-10 p-8 sm:p-10 lg:grid-cols-[0.9fr_1.1fr]">
			<div>
				<p class="font-mono text-sm text-esap-blue-strong">{m.home.featured.kicker}</p>
				<h2 class="mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
					{m.home.featured.title}
				</h2>
				<p class="mt-4 text-sm leading-relaxed text-muted-foreground sm:text-base">
					{m.home.featured.body}
				</p>
				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a
						href={DRIVE_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex h-10 items-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
					>
						{m.home.featured.cta}
					</a>
					<a
						href={DRIVE_GITHUB_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex h-10 items-center rounded-lg bg-surface-3 px-5 text-sm font-medium text-foreground transition-colors hover:bg-muted"
					>
						{m.home.featured.repoCta}
					</a>
				</div>
			</div>

			{/* 物料必须产品原生：组织旗舰系统的真实面板截图，亮暗双版实拍 */}
			<div
				class="overflow-hidden rounded-xl [filter:drop-shadow(0_18px_36px_rgba(0,0,0,0.14))] dark:[filter:drop-shadow(0_18px_40px_rgba(0,0,0,0.5))]"
			>
				<Image
					src={shotLight}
					alt={m.home.featured.alt}
					widths={[640, 960, 1280]}
					sizes="(max-width: 1024px) 100vw, 560px"
					class="h-auto w-full dark:hidden"
					loading="lazy"
				/>
				<Image
					src={shotDark}
					alt={m.home.featured.alt}
					widths={[640, 960, 1280]}
					sizes="(max-width: 1024px) 100vw, 560px"
					class="hidden h-auto w-full dark:block"
					loading="lazy"
				/>
			</div>
		</div>

		{/* 组织不只有一个产品的证据行 */}
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-border px-8 py-4 sm:px-10">
			<span class="text-xs font-medium tracking-wide text-muted-foreground uppercase">
				{m.home.featured.alsoRunning.label}
			</span>
			{
				m.home.featured.alsoRunning.items.map((item) => (
					<a
						href={item.href}
						target="_blank"
						rel="noopener noreferrer"
						class="text-sm font-medium text-foreground transition-colors hover:text-esap-blue-strong"
					>
						{item.name}
					</a>
				))
			}
			<a
				href={pagePath(lang, "projects")}
				class="ml-auto inline-flex items-center gap-1 text-sm font-medium text-esap-blue-strong transition-opacity hover:opacity-80"
			>
				{m.home.featured.alsoRunning.allCta}
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h14" />
					<path d="m12 5 7 7-7 7" />
				</svg>
			</a>
		</div>
	</div>
</section>
