---
import { type Lang, t } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);

/* ESAP 粉 / AsterCosmos 蓝：两个同级组织的对照卡 */
const pillarAccents = ["border-esap-pink", "border-esap-blue"] as const;
---

<section id="archive" data-reveal class="mx-auto max-w-6xl scroll-mt-20 px-6 py-24">
	<div class="max-w-3xl">
		<p class="font-mono text-sm text-esap-pink-strong">{m.archive.kicker}</p>
		<h2 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
			{m.archive.title}
		</h2>
		<p class="mt-5 text-base leading-relaxed text-muted-foreground">
			{m.archive.description}
		</p>
	</div>

	<div class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-border sm:grid-cols-2">
		{
			m.archive.pillars.map((pillar, i) => (
				<div class={`border-t-2 bg-surface-3 p-7 ${pillarAccents[i]}`}>
					<p class="font-mono text-xs tracking-wide text-muted-foreground uppercase">
						{pillar.subheading}
					</p>
					<h3 class="mt-3 text-xl font-semibold tracking-tight">{pillar.heading}</h3>
					<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{pillar.body}</p>
					<a
						href={pillar.href}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-esap-blue-strong transition-opacity hover:opacity-80"
					>
						{pillar.cta}
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M7 17 17 7" />
							<path d="M7 7h10v10" />
						</svg>
					</a>
				</div>
			))
		}
	</div>

	<ul class="mt-10 grid gap-4 sm:grid-cols-3">
		{
			m.archive.points.map((point) => (
				<li class="flex items-start gap-3 text-sm leading-relaxed text-muted-foreground">
					<span class="mt-2 inline-block size-1.5 shrink-0 rounded-full bg-esap-pink" aria-hidden="true" />
					{point}
				</li>
			))
		}
	</ul>
</section>
