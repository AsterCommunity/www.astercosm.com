---
import { docsUrl, GITHUB_URL, type Lang, t } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);

const columns = [
	{
		heading: m.footer.product,
		links: [
			{ label: m.footer.docs, href: docsUrl(lang, "/") },
			{
				label: m.footer.quickStart,
				href: docsUrl(lang, "/start/quick-trial/"),
			},
			{ label: m.footer.dockerDeploy, href: docsUrl(lang, "/deploy/docker/") },
			{ label: m.footer.k8s, href: docsUrl(lang, "/deploy/kubernetes/") },
		],
	},
	{
		heading: m.footer.community,
		links: [
			{ label: "GitHub", href: GITHUB_URL },
			{ label: m.footer.issues, href: `${GITHUB_URL}/issues` },
			{ label: m.footer.releases, href: `${GITHUB_URL}/releases` },
		],
	},
	{
		heading: m.footer.legal,
		links: [
			{ label: m.footer.security, href: `${GITHUB_URL}/security` },
			{ label: m.footer.license, href: `${GITHUB_URL}#license` },
		],
	},
];
---

<footer class="bg-surface-2">
	<div class="mx-auto max-w-6xl px-6 py-14">
		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			<div>
				<img src="/brand/asterdrive-dark.svg" alt="AsterDrive" class="h-9 w-auto dark:hidden" draggable="false" />
				<img src="/brand/asterdrive-light.svg" alt="AsterDrive" class="hidden h-9 w-auto dark:block" draggable="false" />
				<p class="mt-4 max-w-48 text-sm leading-relaxed text-muted-foreground">
					{m.footer.tagline}
				</p>
			</div>

			{
				columns.map((col) => (
					<nav aria-label={col.heading}>
						<h3 class="text-sm font-medium">{col.heading}</h3>
						<ul class="mt-4 space-y-2.5">
							{col.links.map((link) => (
								<li>
									<a
										href={link.href}
										target="_blank"
										rel="noopener noreferrer"
										class="text-sm text-muted-foreground transition-colors hover:text-foreground"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>

		<p class="mt-12 text-xs text-muted-foreground">{m.footer.copyright}</p>
	</div>
</footer>
