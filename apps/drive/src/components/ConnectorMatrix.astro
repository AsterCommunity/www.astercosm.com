---
import { connectors } from "@/i18n/connectors";
import { docsUrl, type Lang, t } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);
---

<section id="storage" data-reveal class="scroll-mt-20 bg-surface-2">
	<div class="mx-auto max-w-6xl px-6 py-24">
		<h2 class="max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
			{m.connectors.title}
		</h2>
		<p class="mt-5 max-w-2xl leading-relaxed text-muted-foreground">
			{m.connectors.subtitle}
		</p>

		<div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				connectors.map((c) => (
					<div class="rounded-xl bg-surface-3 p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/10 dark:hover:shadow-black/30">
						<div class="flex items-center gap-3">
							{c.logo ? (
								<img
									src={c.logo}
									alt=""
									width="36"
									height="36"
									loading="lazy"
									class="size-9 shrink-0 object-contain"
								/>
							) : (
								<span
									class="flex size-9 shrink-0 items-center justify-center rounded-lg border text-[11px] font-semibold"
									style={`--badge-rgb: ${c.badgeRgb.join(" ")}; border-color: rgb(var(--badge-rgb) / 0.55); background-color: rgb(var(--badge-rgb) / 0.12); color: rgb(var(--badge-rgb));`}
									aria-hidden="true"
								>
									{c.glyph}
								</span>
							)}
							<h3 class="text-sm font-medium">{c.name[lang]}</h3>
						</div>
						<p class="mt-3 text-[13px] leading-relaxed text-muted-foreground">{c.bestFor[lang]}</p>
					</div>
				))
			}
		</div>

		<a
			href={docsUrl(lang, "/admin/storage-backends/")}
			target="_blank"
			rel="noopener noreferrer"
			class="mt-10 inline-flex items-center gap-1.5 text-sm text-primary transition-opacity hover:opacity-80"
		>
			{m.connectors.docsCta}
			<span aria-hidden="true">→</span>
		</a>
	</div>
</section>
