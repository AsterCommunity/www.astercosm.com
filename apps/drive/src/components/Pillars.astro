---
import { type Lang, t } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);
---

<section id="features" data-reveal class="mx-auto max-w-6xl scroll-mt-20 px-6 py-24">
	<h2 class="max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
		{m.pillars.title}
	</h2>
	<div class="mt-14 grid gap-12 md:grid-cols-3">
		{
			m.pillars.items.map((item, i) => (
				<div>
					<span class="font-mono text-sm text-primary">{String(i + 1).padStart(2, "0")}</span>
					<h3 class="mt-3 text-lg font-medium">{item.title}</h3>
					<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{item.body}</p>
				</div>
			))
		}
	</div>
</section>
