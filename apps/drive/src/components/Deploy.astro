---
import { docsUrl, type Lang, t } from "@/i18n/ui";
import { TerminalDemo } from "@/islands/TerminalDemo";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);

const terminalLines = [
	"mkdir -p ./data && sudo chown -R 10001:10001 ./data",
	"docker run -d \\",
	"  --name asterdrive \\",
	"  -p 127.0.0.1:3000:3000 \\",
	"  -e ASTER__SERVER__HOST=0.0.0.0 \\",
	'  -e "ASTER__DATABASE__URL=sqlite:///data/asterdrive.db?mode=rwc" \\',
	'  -v "$(pwd)/data:/data" \\',
	"  ghcr.io/astercommunity/asterdrive:latest",
];
---

<section id="deploy" data-reveal class="scroll-mt-20 bg-surface-2">
	<div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-24 lg:grid-cols-2">
		<div>
			<h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
				{m.deploy.title}
			</h2>
			<p class="mt-5 leading-relaxed text-muted-foreground">
				{m.deploy.subtitle}
			</p>
			<div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
				<a
					href={docsUrl(lang, "/deploy/docker/")}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 text-sm text-primary transition-opacity hover:opacity-80"
				>
					{m.deploy.dockerCta}
					<span aria-hidden="true">→</span>
				</a>
				<a
					href={docsUrl(lang, "/deploy/kubernetes/")}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 text-sm text-primary transition-opacity hover:opacity-80"
				>
					{m.deploy.k8sCta}
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>

		<TerminalDemo client:visible lines={terminalLines} />
	</div>
</section>
