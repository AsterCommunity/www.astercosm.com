---
import { GITHUB_URL, type Lang, t, WWW_URL } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);
---

<section class="mx-auto max-w-6xl px-6 pt-20 pb-16 lg:pt-28">
	<div class="hero-rise mx-auto max-w-3xl text-center">
		<p
			class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-2 px-4 py-1.5 text-sm text-muted-foreground"
		>
			<span class="relative flex size-2" aria-hidden="true">
				<span
					class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-60 motion-reduce:animate-none"
				></span>
				<span class="relative inline-flex size-2 rounded-full bg-primary"></span>
			</span>
			{m.hero.status}
		</p>
		<h1
			class="mt-7 text-4xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl"
		>
			{m.hero.title}
		</h1>
		<p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
			{m.hero.subtitle}
		</p>
		<div class="mt-9 flex flex-wrap items-center justify-center gap-3">
			<a
				href={GITHUB_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-11 items-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
			>
				{m.hero.primaryCta}
			</a>
			<a
				href={WWW_URL}
				class="inline-flex h-11 items-center rounded-lg bg-surface-2 px-6 text-sm font-medium text-foreground transition-colors hover:bg-muted"
			>
				{m.hero.secondaryCta}
			</a>
		</div>
	</div>
</section>
