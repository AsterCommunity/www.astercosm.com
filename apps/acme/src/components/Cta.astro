---
import { GITHUB_URL, type Lang, t, WWW_URL } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);
---

{/* drive 同款：结尾 CTA 不做色带，页面底色上靠 surface 台阶区分按钮 */}
<section data-reveal class="mx-auto max-w-6xl px-6 pt-8 pb-28 text-center">
	<h2 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
		{m.cta.title}
	</h2>
	<p class="mx-auto mt-5 max-w-xl leading-relaxed text-muted-foreground">{m.cta.body}</p>
	<div class="mt-9 flex flex-wrap items-center justify-center gap-3">
		<a
			href={GITHUB_URL}
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex h-11 items-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
		>
			{m.cta.primary}
		</a>
		<a
			href={WWW_URL}
			class="inline-flex h-11 items-center rounded-lg bg-surface-2 px-6 text-sm font-medium text-foreground transition-colors hover:bg-muted"
		>
			{m.cta.secondary}
		</a>
	</div>
</section>
