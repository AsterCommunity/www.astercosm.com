---
import { GITHUB_URL, type Lang, t, WWW_URL } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);
---

<footer class="bg-surface-2">
	<div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-12 sm:flex-row sm:items-center sm:justify-between">
		<div>
			<img src="/brand/asteracme-dark.svg" alt="AsterACME" class="h-9 w-auto dark:hidden" draggable="false" />
			<img src="/brand/asteracme-light.svg" alt="AsterACME" class="hidden h-9 w-auto dark:block" draggable="false" />
			<p class="mt-4 max-w-48 text-sm leading-relaxed text-muted-foreground">{m.footer.tagline}</p>
		</div>

		<div class="flex items-center gap-6 text-sm text-muted-foreground">
			<a
				href={GITHUB_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="transition-colors hover:text-foreground"
			>
				GitHub
			</a>
			<a href={WWW_URL} class="transition-colors hover:text-foreground">AsterCosmos</a>
		</div>
	</div>
	<div class="mx-auto max-w-6xl space-y-1 px-6 pb-8 text-xs text-muted-foreground">
		<p>{m.footer.copyright}</p>
		<p>{m.footer.license}</p>
	</div>
</footer>
