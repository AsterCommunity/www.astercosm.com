---
import CodeBlock from "@/components/CodeBlock.astro";
import { addCrateLines, generateLines } from "@/i18n/code";
import { DOCS_URL, type Lang, t } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);

const integrationUrl = `${DOCS_URL}/guide/new-project-integration`;
const rustdocUrl = `${DOCS_URL}/crates/rustdoc/`;
---

<section id="start" data-reveal class="scroll-mt-16 bg-surface-2">
	<div class="mx-auto max-w-6xl px-6 py-20 lg:py-24">
		{/* 版式与上一节错开：标题通栏，命令并排，不重复「窄标题 + 宽内容」的骨架 */}
		<div class="max-w-2xl">
			<p class="font-mono text-sm text-primary">{m.start.kicker}</p>
			<h2 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
				{m.start.title}
			</h2>
			<p class="mt-5 leading-relaxed text-muted-foreground">{m.start.body}</p>
		</div>

		{/* 命令行含完整 git URL，并排会横向截断，改为整宽堆叠 */}
		<div class="mt-12 space-y-10">
			<div>
				<h3 class="font-mono text-xs tracking-wide text-muted-foreground uppercase">
					{m.start.step1}
				</h3>
				<div class="mt-3">
					<CodeBlock lines={generateLines} label={m.start.step1} />
				</div>
			</div>

			<div>
				<h3 class="font-mono text-xs tracking-wide text-muted-foreground uppercase">
					{m.start.step2}
				</h3>
				<p class="mt-2 text-sm text-muted-foreground">{m.start.step2Body}</p>
				<div class="mt-3">
					<CodeBlock lines={addCrateLines} label={m.start.step2} />
				</div>
			</div>
		</div>

		<div class="mt-10 flex flex-wrap gap-3">
			<a
				href={integrationUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-11 items-center gap-2 rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-hover"
			>
				{m.start.docsCta}
				<span aria-hidden="true">↗</span>
			</a>
			<a
				href={rustdocUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-11 items-center gap-2 rounded-lg bg-surface-3 px-6 text-sm font-medium text-foreground transition-colors hover:bg-muted"
			>
				{m.start.apiCta}
				<span aria-hidden="true">↗</span>
			</a>
		</div>
	</div>
</section>
