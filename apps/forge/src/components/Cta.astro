---
import { DOCS_URL, type Lang, t, WWW_URL } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const m = t(lang);

const docsHome = lang === "zh" ? `${DOCS_URL}/` : `${DOCS_URL}/en/`;
---

<section data-reveal class="border-t border-border bg-surface-2">
	<div class="mx-auto max-w-6xl px-6 py-20 text-center lg:py-24">
		<h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
			{m.cta.title}
		</h2>
		<p class="mx-auto mt-5 max-w-xl leading-relaxed text-muted-foreground">{m.cta.body}</p>
		<div class="mt-9 flex flex-wrap items-center justify-center gap-3">
			<a
				href={docsHome}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-11 items-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-hover"
			>
				{m.cta.primary}
			</a>
			<a
				href={WWW_URL}
				class="inline-flex h-11 items-center rounded-lg bg-surface-3 px-6 text-sm font-medium text-foreground transition-colors hover:bg-muted"
			>
				{m.cta.secondary}
			</a>
		</div>
	</div>
</section>
