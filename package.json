{
	"name": "www-astercosm-com",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun --filter @astercosm/www --filter @astercosm/drive --filter @astercosm/gate --filter @astercosm/forge --filter @astercosm/acme dev",
		"dev:www": "bun --filter @astercosm/www dev",
		"dev:drive": "bun --filter @astercosm/drive dev",
		"dev:gate": "bun --filter @astercosm/gate dev",
		"dev:forge": "bun --filter @astercosm/forge dev",
		"dev:acme": "bun --filter @astercosm/acme dev",
		"build": "bun --filter @astercosm/www --filter @astercosm/drive --filter @astercosm/gate --filter @astercosm/forge --filter @astercosm/acme build",
		"preview": "bun --filter @astercosm/www --filter @astercosm/drive --filter @astercosm/gate --filter @astercosm/forge --filter @astercosm/acme preview",
		"preview:www": "bun --filter @astercosm/www preview",
		"preview:drive": "bun --filter @astercosm/drive preview",
		"preview:gate": "bun --filter @astercosm/gate preview",
		"preview:forge": "bun --filter @astercosm/forge preview",
		"preview:acme": "bun --filter @astercosm/acme preview",
		"check": "biome check . && bun --filter @astercosm/www --filter @astercosm/drive --filter @astercosm/gate --filter @astercosm/forge --filter @astercosm/acme check",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"capture:esap": "bun --filter @astercosm/www capture:esap",
		"capture:scenes": "bun --filter @astercosm/drive capture:scenes"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"wrangler": "^4.152.0"
	},
	"overrides": {
		"sharp": "npm:imagemagick@0.1.3"
	},
	"packageManager": "bun@1.4.0"
}
