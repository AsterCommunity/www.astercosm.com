{
	"name": "www-astercosm-com",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:www": "bun --filter @astercosm/www dev",
		"dev:drive": "bun --filter @astercosm/drive dev",
		"build": "bun --filter @astercosm/www --filter @astercosm/drive build",
		"preview:www": "bun --filter @astercosm/www preview",
		"preview:drive": "bun --filter @astercosm/drive preview",
		"check": "biome check . && bun --filter @astercosm/www --filter @astercosm/drive check",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"capture:esap": "bun --filter @astercosm/www capture:esap",
		"capture:scenes": "bun --filter @astercosm/drive capture:scenes"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"wrangler": "^4.152.0"
	},
	"overrides": {
		"sharp": "npm:imagemagick@0.1.3"
	},
	"packageManager": "bun@1.4.0"
}
